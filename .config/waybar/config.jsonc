{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "wlr/taskbar",
        "custom/minimized"
    ],
    "modules-center": [
        "clock",
        "mpris"
    ],
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "player-icons": { "default": "󰐊", "spotify": "󰓇", "firefox": "󰗃", "librewolf": "󰗃" },
        "status-icons": { "paused": "󰏤" },
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 45,
        "tooltip-format": "{player}: {title} — {artist}\nClick: play/pause · Right-click: next · Scroll: skip",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "modules-right": [
        "tray",
        "pulseaudio",
        "network",
        "bluetooth",
        "battery",
        "custom/notification",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "custom/minimized": {
        "exec": "hyprctl clients -j | jq '[.[] | select(.workspace.name==\"special:minimized\")] | length | if . == 0 then empty else . end'",
        "interval": 2,
        "format": "󰘸 {}",
        "on-click": "~/.config/hypr/scripts/restore.sh",
        "tooltip-format": "Minimized windows: click to restore"
    },
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "on-click": "activate",
        "on-click-middle": "close",
        "tooltip-format": "{title}"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "spacing": 8
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "on-click": "blueman-manager"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },
    "custom/notification": {
        "format": "󰂚",
        "on-click": "swaync-client -t -sw",
        "tooltip": false
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/power.sh",
        "tooltip": false
    }
}
