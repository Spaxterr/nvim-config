{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 4,
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "wlr/taskbar",
        "custom/minimized"
    ],
    "modules-center": [
        "clock",
        "mpris"
    ],
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "player-icons": { "default": "󰐊", "spotify": "󰓇", "firefox": "󰗃", "librewolf": "󰗃" },
        "status-icons": { "paused": "󰏤" },
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 45,
        "tooltip-format": "{player}: {title} — {artist}\nClick: play/pause · Right-click: next · Scroll: skip",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next"
    },
    "modules-right": [
        "tray",
        "pulseaudio",
        "pulseaudio#mic",
        "network",
        "bluetooth",
        "battery",
        "custom/notification",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "custom/minimized": {
        "exec": "~/.config/waybar/minimized.sh",
        "format": "󰘸 {}",
        "on-click": "~/.config/hypr/scripts/restore.sh",
        "tooltip-format": "Minimized windows: click to restore"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "\uf111",
            "empty": "\uf10c",
            "default": "\uf111"
        },
        "on-click": "activate"
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "on-click": "activate",
        "on-click-middle": "close",
        "tooltip-format": "{title}"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "spacing": 8
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "{source_desc} ({source_volume}%)\nClick: mute mic · Right-click: input settings · Scroll: mic volume",
        "on-click": "~/.config/hypr/scripts/mic-toggle.sh",
        "on-click-right": "pavucontrol -t 4",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "on-click": "blueman-manager"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },
    "custom/notification": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "format": "{icon}",
        "format-icons": {
            "none": "󰂚",
            "notification": "󰂞",
            "dnd-none": "󰂛",
            "dnd-notification": "󰂛",
            "inhibited-none": "󰂚",
            "inhibited-notification": "󰂞",
            "dnd-inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂛"
        },
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/power.sh",
        "tooltip": false
    }
}
