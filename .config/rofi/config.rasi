configuration {
    modes: "drun,run,window";
    show-icons: true;
    window-format: "{c}  ·  {t}";
    font: "Inter, JetBrainsMono Nerd Font 12";
    icon-theme: "Tela-circle-dracula-dark";
    display-drun: "󰍉";
    display-run: "";
    display-window: "󰖶";
}

* {
    background-color: transparent;
    text-color: #c6d0f5;
    border: 0;
}

/* Gradient frame: the window is painted mauve→blue, the glass panel sits 2px inside it */
window {
    width: 560px;
    background-image: linear-gradient(135deg, #ca9ee6, #8caaee);
    border-radius: 16px;
    padding: 2px;
}
mainbox { background-color: #303446e0; border-radius: 14px; padding: 14px; spacing: 10px; }
inputbar { children: [prompt, entry]; spacing: 10px; padding: 10px 12px; border-radius: 10px; background-color: #41455980; }
prompt { text-color: #ca9ee6; font: "JetBrainsMono Nerd Font 15"; }
entry { placeholder-color: #838ba7; }
listview { lines: 8; spacing: 4px; scrollbar: false; border: 0; }
element { padding: 8px 10px; border-radius: 10px; spacing: 10px; }
element normal.normal, element alternate.normal { background-color: transparent; text-color: #c6d0f5; }
element normal.active, element alternate.active { background-color: transparent; text-color: #8caaee; }
element selected.normal, element selected.active { background-color: #ca9ee633; text-color: #ca9ee6; }
element-icon { size: 28px; }
element-text { text-color: inherit; }
